new file mode 100644
index 0000000..9b64272
--- /dev/null
+++ b/app/src/main/java/sync/RetryPolicy.kt
@@ -0,0 +1,12 @@
+package sync
+
+enum class SyncPhase { IDLE, FETCHING, WAITING, FAILED }
+
+data class RetryPolicy(val maxAttempts: Int) {
+    suspend fun <T> attempt(block: suspend () -> T): T {
+        repeat(maxAttempts - 1) {
+            try { return block() } catch (e: Exception) { }
+        }
+        return block()
+    }
+}
