@@ -0,0 +1,14 @@
+import UIKit
+
+/// Keeps the thumbnails of the feed in memory.
+final class ThumbnailCache {
+    private var images: [URL: UIImage] = [:]
+
+    // Generated thumbnails are cached on disk too: see ThumbnailStore.
+    func image(for url: URL) -> UIImage? {
+        images[url]
+    }
+
+    func store(_ image: UIImage, for url: URL) {
+        images[url] = image
+    }
+}
