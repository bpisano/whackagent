+//
+//  KeypadEdgeReach.swift
+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+/// How far the keypad spreads on its sides, decided by a `LayoutModeRule`.
+enum KeypadEdgeReach: Sendable, Equatable {
+    /// The keypad stays within the safe area.
+    case safeArea
+    /// The keypad spreads to both physical sides of the screen, over the horizontal safe area.
+    case screenEdges
+    /// The keypad spreads to each physical side of the screen no `.occlusion` crosses at its height, and stays within the safe area until the occlusions are read.
+    case unoccludedScreenEdges
+
+    /// The sides of the safe area the keypad spreads over.
+    ///
+    /// - Parameters:
+    ///   - occlusions: The occlusions of the screen, or `nil` until they are read.
+    ///   - keypadSpan: The height the keypad spans, in the same space as the occlusions, or `nil` before it is laid out.
+    /// - Returns: The horizontal edges of the safe area to ignore.
+    func ignoredEdges(clearOf occlusions: [ScreenOcclusion]?, alongside keypadSpan: ClosedRange<CGFloat>?) -> Edge.Set {
+        switch self {
+        case .safeArea:
+            []
+        case .screenEdges:
+            .horizontal
+        case .unoccludedScreenEdges:
+            occlusions?
+                .filter { occlusion in keypadSpan.map(occlusion.crosses) ?? false }
+                .reduce(into: .horizontal) { edges, occlusion in edges.remove(occlusion.edge) } ?? []
+        }
+    }
+}
+
+#if DEBUG
+import Playgrounds
+
+#Playground("KeypadEdgeReach · a closed foldable in landscape") {
+    let keypadSpan: ClosedRange<CGFloat> = 200...440
+    let reach: KeypadEdgeReach = .unoccludedScreenEdges
+    print("camera top left:", reach.ignoredEdges(clearOf: [.mock()], alongside: keypadSpan))
+    print("camera bottom right:", reach.ignoredEdges(clearOf: [.mock(side: .trailing, verticalSpan: 384...466)], alongside: keypadSpan))
+}
+#endif
