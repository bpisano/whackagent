+//
+//  ScreenOcclusionsModifier.swift
+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+/// Reads the `.occlusion` regions of the whole screen, safe area included, and hands them down as `\.screenOcclusions`, each time one appears, moves or goes away, or `nil` until they are read.
+struct ScreenOcclusionsModifier: ViewModifier {
+    @State private var occlusions: [ScreenOcclusion]?
+
+    func body(content: Content) -> some View {
+        content
+            .environment(\.screenOcclusions, occlusions)
+            .background {
+                if #available(anyAppleOS 27.1, *) {
+                    Color.clear
+                        .onGeometryChange(for: [ScreenOcclusion].self) { proxy in
+                            let screenTop: CGFloat = proxy.frame(in: .global).minY
+                            return proxy.reservedRegions(kind: .occlusion).map { region in
+                                ScreenOcclusion(
+                                    frame: region.frame.offsetBy(dx: 0, dy: screenTop),
+                                    onScreenOfWidth: proxy.size.width
+                                )
+                            }
+                        } action: { occlusions in
+                            self.occlusions = occlusions
+                        }
+                        .ignoresSafeArea()
+                }
+            }
+    }
+}
