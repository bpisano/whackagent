+//
+//  DivisionAxisChangeModifier.swift
+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+/// Reports the axis of the `.division` that crosses the view, each time it appears, moves or goes away.
+struct DivisionAxisChangeModifier: ViewModifier {
+    private let action: (Axis?) -> Void
+
+    /// Creates the modifier.
+    ///
+    /// - Parameters:
+    ///   - action: The action to run with the new axis, `nil` when no active `.division` crosses the view.
+    init(_ action: @escaping (Axis?) -> Void) {
+        self.action = action
+    }
+
+    func body(content: Content) -> some View {
+        if #available(anyAppleOS 27.1, *) {
+            content
+                .onGeometryChange(for: Axis?.self) { proxy in
+                    proxy.reservedRegions(kind: .division).first.map { Axis(longSideOf: $0.frame.size) }
+                } action: { axis in
+                    action(axis)
+                }
+        } else {
+            content
+        }
+    }
+}
