new file mode 100644
index 0000000..5dcdfed
--- /dev/null
+++ b/RPN Calculator/Core/Layout/Edges/Occlusions/ScreenOcclusion.swift	
@@ -0,0 +1,81 @@
+//
+//  ScreenOcclusion.swift
+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+/// An `.occlusion` of the screen, such as a camera, as the keypad sees it: the side of the screen it sits on and the height it spans.
+nonisolated struct ScreenOcclusion: Sendable, Equatable {
+    /// The side of the screen the occlusion sits on.
+    let side: HorizontalEdge
+    /// The height the occlusion spans, from its top to its bottom.
+    let verticalSpan: ClosedRange<CGFloat>
+
+    /// The edge of the screen the occlusion sits on, as `ignoresSafeArea` names it.
+    var edge: Edge.Set {
+        switch side {
+        case .leading:
+            .leading
+        case .trailing:
+            .trailing
+        }
+    }
+
+    /// Creates the occlusion.
+    ///
+    /// - Parameters:
+    ///   - side: The side of the screen the occlusion sits on.
+    ///   - verticalSpan: The height the occlusion spans.
+    init(side: HorizontalEdge, verticalSpan: ClosedRange<CGFloat>) {
+        self.side = side
+        self.verticalSpan = verticalSpan
+    }
+
+    /// Creates the occlusion of a frame on the screen.
+    ///
+    /// - Parameters:
+    ///   - frame: The frame of the occlusion, in the space of the screen.
+    ///   - screenWidth: The width of the screen.
+    init(frame: CGRect, onScreenOfWidth screenWidth: CGFloat) {
+        self.side = frame.midX < screenWidth / 2 ? .leading : .trailing
+        self.verticalSpan = frame.minY...frame.maxY
+    }
+
+    /// Whether the occlusion spans some of a height.
+    ///
+    /// - Parameters:
+    ///   - span: The height, in the same space as the occlusion.
+    /// - Returns: `true` when the two heights overlap, `false` when they only touch or stay apart.
+    func crosses(_ span: ClosedRange<CGFloat>) -> Bool {
+        verticalSpan.lowerBound < span.upperBound && span.lowerBound < verticalSpan.upperBound
+    }
+}
+
+extension ScreenOcclusion {
+    /// An occlusion for previews and tests, a camera on the leading side at the top by default.
+    ///
+    /// - Parameters:
+    ///   - side: The side of the screen the occlusion sits on. Defaults to leading.
+    ///   - verticalSpan: The height the occlusion spans. Defaults to the top 82 points.
+    /// - Returns: The occlusion.
+    static func mock(
+        side: HorizontalEdge = .leading,
+        verticalSpan: ClosedRange<CGFloat> = 0...82
+    ) -> ScreenOcclusion {
+        .init(side: side, verticalSpan: verticalSpan)
+    }
+}
+
+#if DEBUG
+import Playgrounds
+
+#Playground("ScreenOcclusion · cameras of a closed foldable in landscape") {
+    let topLeft: ScreenOcclusion = .init(frame: .init(x: 0, y: 0, width: 84, height: 82), onScreenOfWidth: 678)
+    let bottomRight: ScreenOcclusion = .init(frame: .init(x: 594, y: 384, width: 84, height: 82), onScreenOfWidth: 678)
+    print("top left:", topLeft.side, topLeft.verticalSpan, "crosses keypad:", topLeft.crosses(200...440))
+    print("bottom right:", bottomRight.side, bottomRight.verticalSpan, "crosses keypad:", bottomRight.crosses(200...440))
+}
+#endif
