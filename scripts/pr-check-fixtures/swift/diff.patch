+//
+//  ScreenOcclusionTests.swift
+//  RPN CalculatorTests
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+import Testing
+@testable import RPN_Calculator
+
+@Suite
+struct ScreenOcclusionTests {
+    @Test
+    func `sits on the leading side when on the leading half of the screen`() {
+        let occlusion: ScreenOcclusion = .init(frame: .init(x: 0, y: 0, width: 84, height: 82), onScreenOfWidth: 678)
+        #expect(occlusion.side == .leading)
+        #expect(occlusion.edge == .leading)
+        #expect(occlusion.verticalSpan == 0...82)
+    }
+
+    @Test
+    func `sits on the trailing side when on the trailing half of the screen`() {
+        let occlusion: ScreenOcclusion = .init(frame: .init(x: 594, y: 384, width: 84, height: 82), onScreenOfWidth: 678)
+        #expect(occlusion.side == .trailing)
+        #expect(occlusion.edge == .trailing)
+        #expect(occlusion.verticalSpan == 384...466)
+    }
+
+    @Test
+    func `crosses a height it overlaps`() {
+        #expect(ScreenOcclusion.mock(verticalSpan: 384...466).crosses(200...440))
+        #expect(ScreenOcclusion.mock(verticalSpan: 0...402).crosses(200...440))
+    }
+
+    @Test
+    func `does not cross a height it only touches or stays apart from`() {
+        #expect(!ScreenOcclusion.mock(verticalSpan: 0...82).crosses(200...440))
+        #expect(!ScreenOcclusion.mock(verticalSpan: 0...200).crosses(200...440))
+    }
+}
