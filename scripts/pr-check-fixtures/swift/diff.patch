+//
+//  HingeStatusChangeModifier.swift
+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+/// Reports how far the screen of the device is opened, each time it folds or unfolds.
+struct HingeStatusChangeModifier: ViewModifier {
+    private let action: (HingeStatus?) -> Void
+
+    /// Creates the modifier.
+    ///
+    /// - Parameters:
+    ///   - action: The action to run with the new status, `nil` on a device without hinge.
+    init(_ action: @escaping (HingeStatus?) -> Void) {
+        self.action = action
+    }
+
+    func body(content: Content) -> some View {
+        if #available(anyAppleOS 27.1, *) {
+            content
+                .onHingeChange { _, context in
+                    action(context.hinge.flatMap { HingeStatus($0.status) })
+                }
+        } else {
+            content
+        }
+    }
+}
