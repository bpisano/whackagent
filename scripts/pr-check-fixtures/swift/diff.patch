+//
+//  HingeStatus.swift
+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+/// How far the screen of a foldable iPhone is opened.
+enum HingeStatus: Sendable, Equatable {
+    /// Folded shut, only the outer screen in use.
+    case closed
+    /// Half folded, the screen bent along its `.division`.
+    case partiallyOpen
+    /// Opened flat.
+    case fullyOpen
+}
+
+extension HingeStatus {
+    /// The status of a hinge the system reports.
+    ///
+    /// - Parameters:
+    ///   - status: The status the system reports.
+    /// - Returns: The matching status, or `nil` for a status this version of the app does not know.
+    @available(anyAppleOS 27.1, *)
+    init?(_ status: DeviceHinge.Status) {
+        switch status {
+        case .closed:
+            self = .closed
+        case .partiallyOpen:
+            self = .partiallyOpen
+        case .fullyOpen:
+            self = .fullyOpen
+        default:
+            return nil
+        }
+    }
+}
