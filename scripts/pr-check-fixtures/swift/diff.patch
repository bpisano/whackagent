+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+/// Spreads the keypad over the horizontal safe area, to the physical sides of the screen the layout rule and the occlusions of the screen leave it.
+struct KeypadScreenEdgesModifier: ViewModifier {
+    private let keypadSpan: ClosedRange<CGFloat>?
+
+    @Environment(\.keypadEdgeReach) private var reach: KeypadEdgeReach
+    @Environment(\.screenOcclusions) private var occlusions: [ScreenOcclusion]?
+
+    /// Creates the modifier.
+    ///
+    /// - Parameters:
+    ///   - keypadSpan: The height the keypad spans in the global space, or `nil` before it is laid out.
+    init(alongside keypadSpan: ClosedRange<CGFloat>?) {
+        self.keypadSpan = keypadSpan
+    }
+
+    func body(content: Content) -> some View {
+        content
+            .ignoresSafeArea(.container, edges: reach.ignoredEdges(clearOf: occlusions, alongside: keypadSpan))
+    }
+}
+
