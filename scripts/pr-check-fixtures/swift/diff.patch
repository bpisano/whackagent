+//
+//  HingeRuleTests.swift
+//  RPN CalculatorTests
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+import Testing
+@testable import RPN_Calculator
+
+@Suite
+struct HingeRuleTests {
+    private let rule: HingeRule = .init()
+
+    @Test
+    func `follows the size classes without hinge`() {
+        #expect(rule.mode(for: .mock()) == .compact)
+        #expect(rule.mode(for: .mock(verticalSizeClass: .compact, containerAxis: .horizontal)) == .wide)
+        #expect(rule.mode(for: .mock(horizontalSizeClass: .regular, verticalSizeClass: .regular)) == .wide)
+    }
+
+    @Test
+    func `follows the size classes when closed`() {
+        #expect(rule.mode(for: .mock(hingeStatus: .closed)) == .compact)
+        #expect(rule.mode(for: .mock(verticalSizeClass: .compact, containerAxis: .horizontal, hingeStatus: .closed)) == .wide)
+    }
+
+    @Test
+    func `is wide when opened flat in landscape, whatever the size classes`() {
+        #expect(rule.mode(for: .mock(horizontalSizeClass: .compact, verticalSizeClass: .regular, containerAxis: .horizontal, hingeStatus: .fullyOpen)) == .wide)
+    }
+
+    @Test
+    func `follows the size classes in the postures it leaves alone`() {
+        #expect(rule.mode(for: .mock(hingeStatus: .fullyOpen)) == .compact)
+        #expect(rule.mode(for: .mock(horizontalSizeClass: .regular, hingeStatus: .fullyOpen)) == .wide)
+        #expect(rule.mode(for: .mock(containerAxis: .horizontal, hingeStatus: .partiallyOpen, divisionAxis: .horizontal)) == .compact)
+    }
+
+    @Test
+    func `does not need a division to decide`() {
+        #expect(rule.mode(for: .mock(containerAxis: .horizontal, hingeStatus: .fullyOpen, divisionAxis: nil)) == .wide)
+        #expect(rule.mode(for: .mock(hingeStatus: .partiallyOpen, divisionAxis: nil)) == .compact)
+    }
+
+    @Test
+    func `delegates to its fallback`() {
+        let rule: HingeRule = .init(fallback: ChosenModeRule(.wide))
+        #expect(rule.mode(for: .mock(hingeStatus: .closed)) == .wide)
+        #expect(rule.keySizing == .pointer)
+    }
+
+    @Test
+    func `spreads the keypad to both sides of the screen when regular in height`() {
+        #expect(rule.keypadEdgeReach(in: .mock(verticalSizeClass: .regular)) == .screenEdges)
+        #expect(rule.keypadEdgeReach(in: .mock(horizontalSizeClass: .regular, containerAxis: .horizontal, hingeStatus: .fullyOpen)) == .screenEdges)
+    }
+
+    @Test
+    func `spreads the keypad to the sides no occlusion crosses when compact in height, hinge or not`() {
+        #expect(rule.keypadEdgeReach(in: .mock(verticalSizeClass: .compact, containerAxis: .horizontal)) == .unoccludedScreenEdges)
+        #expect(rule.keypadEdgeReach(in: .mock(verticalSizeClass: .compact, containerAxis: .horizontal, hingeStatus: .closed)) == .unoccludedScreenEdges)
+    }
+
+    @Test
+    func `asks its fallback where to spread the keypad`() {
+        let rule: HingeRule = .init(fallback: ChosenModeRule(.wide))
+        #expect(rule.keypadEdgeReach(in: .mock(verticalSizeClass: .regular, hingeStatus: .closed)) == .safeArea)
+    }
+
+    @Test
+    func `sizes the keys for a finger`() {
+        #expect(rule.keySizing == .touch)
+    }
+}
