+/// The second condition covers the iPhones whose landscape stays compact in width. A finger presses the keys. The keypad spreads to both sides of the screen when the container is regular in height, and to each side no `.occlusion` crosses at its height when it is compact.
 struct SizeClassRule: LayoutModeRule {
     let keySizing: KeySizing = .touch
 
     func mode(for context: LayoutContext) -> KeypadLayoutMode {
