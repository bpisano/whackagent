+//
+//  AxisExtension.swift
+//  RPN Calculator
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+
+nonisolated extension Axis {
+    /// The axis a rectangle stretches along.
+    ///
+    /// - Parameters:
+    ///   - size: The size of the rectangle.
+    /// - Returns: `.horizontal` when the rectangle is wider than tall, `.vertical` otherwise.
+    init(longSideOf size: CGSize) {
+        self = size.width > size.height ? .horizontal : .vertical
+    }
+}
