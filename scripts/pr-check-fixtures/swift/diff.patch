+//
+//  KeypadEdgeReachTests.swift
+//  RPN CalculatorTests
+//
+//  Created by Benjamin Pisano on 08/11/2026.
+//
+
+import SwiftUI
+import Testing
+@testable import RPN_Calculator
+
+@Suite
+struct KeypadEdgeReachTests {
+    private let keypadSpan: ClosedRange<CGFloat> = 200...440
+    private let leadingCamera: ScreenOcclusion = .mock(side: .leading, verticalSpan: 384...466)
+    private let trailingCamera: ScreenOcclusion = .mock(side: .trailing, verticalSpan: 384...466)
+
+    @Test
+    func `keeps both sides within the safe area`() {
+        #expect(KeypadEdgeReach.safeArea.ignoredEdges(clearOf: [], alongside: keypadSpan) == [])
+    }
+
+    @Test
+    func `spreads to both sides whatever crosses the keypad`() {
+        #expect(KeypadEdgeReach.screenEdges.ignoredEdges(clearOf: [leadingCamera, trailingCamera], alongside: keypadSpan) == .horizontal)
+    }
+
+    @Test
+    func `spreads to both sides when no occlusion crosses the keypad`() {
+        let topCamera: ScreenOcclusion = .mock(side: .leading, verticalSpan: 0...82)
+        #expect(KeypadEdgeReach.unoccludedScreenEdges.ignoredEdges(clearOf: [], alongside: keypadSpan) == .horizontal)
+        #expect(KeypadEdgeReach.unoccludedScreenEdges.ignoredEdges(clearOf: [topCamera], alongside: keypadSpan) == .horizontal)
+    }
+
+    @Test
+    func `spreads only to the trailing side when an occlusion crosses the keypad on the leading side`() {
+        #expect(KeypadEdgeReach.unoccludedScreenEdges.ignoredEdges(clearOf: [leadingCamera], alongside: keypadSpan) == .trailing)
+    }
+
+    @Test
+    func `spreads only to the leading side when an occlusion crosses the keypad on the trailing side`() {
+        #expect(KeypadEdgeReach.unoccludedScreenEdges.ignoredEdges(clearOf: [trailingCamera], alongside: keypadSpan) == .leading)
+    }
+
+    @Test
+    func `keeps both sides within the safe area when occlusions cross the keypad on both sides`() {
+        #expect(KeypadEdgeReach.unoccludedScreenEdges.ignoredEdges(clearOf: [leadingCamera, trailingCamera], alongside: keypadSpan) == [])
+    }
+
+    @Test
+    func `spreads to both sides before the keypad is laid out`() {
+        #expect(KeypadEdgeReach.unoccludedScreenEdges.ignoredEdges(clearOf: [leadingCamera], alongside: nil) == .horizontal)
+    }
+
+    @Test
+    func `keeps both sides within the safe area until the occlusions are read`() {
+        #expect(KeypadEdgeReach.unoccludedScreenEdges.ignoredEdges(clearOf: nil, alongside: keypadSpan) == [])
+    }
+}
