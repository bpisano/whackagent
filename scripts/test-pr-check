#!/usr/bin/env bash
# Proves scripts/pr-check on real diffs: signals found, a body missing them fails, a body
# covering them passes. Run before any commit touching scripts/pr-check.
set -uo pipefail
cd "$(dirname "$0")/.."

F=scripts/pr-check-fixtures
fail=0
err() { echo "❌ $1"; fail=1; }
has() { echo "$1" | grep -qF -- "$2" || err "$3: missing \"$2\""; }

# Swift: PR with 8 new types over 2 mechanisms.
out=$(scripts/pr-check signals --diff $F/swift/diff.patch)
has "$out" "new types: 8" "swift signals"
for t in HingeStatus HingeRule ScreenOcclusion KeypadEdgeReach KeypadScreenEdgesModifier \
         ScreenOcclusionsModifier DivisionAxisChangeModifier HingeStatusChangeModifier; do
  has "$out" "$t (" "swift signals"
done
has "$out" "states: HingeStatus (3)" "swift signals"
has "$out" "LayoutModeRule.keypadEdgeReach required" "swift signals"
has "$out" "LayoutContext.hingeStatus stored" "swift signals"
has "$out" "HingeRule → KeypadEdgeReach" "swift links"
has "$out" "overview: yes" "swift signals"
echo "$out" | grep -q "Tests" && err "swift signals: test file counted"
[ "$fail" = 0 ] && echo "✅ swift signals"

out=$(scripts/pr-check check $F/swift/body-bad.md --diff $F/swift/diff.patch) && err "swift bad body green"
has "$out" "Changes: no fold" "swift bad body"
has "$out" "HingeRule: new type named in no Changes fold" "swift bad body"
has "$out" "To test: UI changed, no path line" "swift bad body"
[ "$fail" = 0 ] && echo "✅ swift bad body fails"

scripts/pr-check check $F/swift/body-good.md --diff $F/swift/diff.patch >/dev/null \
  && echo "✅ swift good body green" || err "swift good body red"

tmp=$(mktemp); awk '/^<details>/ && !h {skip=1} skip && /^<\/details>/ {skip=0; h=1; next} !skip' \
  $F/swift/body-good.md > "$tmp"
out=$(scripts/pr-check check "$tmp" --diff $F/swift/diff.patch) && err "swift body without overview green"
has "$out" "overview:" "swift body without overview"
rm -f "$tmp"
[ "$fail" = 0 ] && echo "✅ swift body without overview fails"

tmp=$(mktemp); awk '/^<br>/ && !h {print; print "```mermaid\nflowchart TD\n    HR[HingeRule] -->|choisit| KER[KeypadEdgeReach]\n    SOM[ScreenOcclusionsModifier] --> KER\n```"; h=1; next} 1' \
  $F/swift/body-good.md > "$tmp"
out=$(scripts/pr-check check "$tmp" --diff $F/swift/diff.patch) && err "swift body with type graph green"
has "$out" "diagram: node \`HingeRule\` is a type" "swift type graph"
has "$out" "diagram: node \`ScreenOcclusionsModifier\` is a type" "swift type graph"
rm -f "$tmp"
[ "$fail" = 0 ] && echo "✅ swift type graph fails"

tmp=$(mktemp); { cat $F/swift/body-good.md; printf '\nLa sheet permet de saisir la distance.\n\nMode Distance actif → une case par ligne → la valeur est sauvée en mètres\n'; } > "$tmp"
out=$(scripts/pr-check check "$tmp" --diff $F/swift/diff.patch) && err "swift body with tics green"
has "$out" "banned word \`permet de\`" "wording"
has "$out" "several \`→\` in a sentence" "wording"
echo "$out" | grep -q "Lancement → écran" && err "wording: path line flagged"
rm -f "$tmp"
[ "$fail" = 0 ] && echo "✅ wording tics fail"

# Kotlin: suspend members, enum class, primary constructor.
out=$(scripts/pr-check signals --diff $F/kotlin/diff.patch)
has "$out" "new types: 2" "kotlin signals"
has "$out" "states: SyncPhase (4)" "kotlin signals"
has "$out" "SyncSource.ping required" "kotlin signals"
has "$out" "SyncEngine constructor changed" "kotlin signals"
has "$out" "failure" "kotlin signals"
echo "$out" | grep -q "RetryPolicyTest" && err "kotlin signals: test file counted"
[ "$fail" = 0 ] && echo "✅ kotlin signals"

# Generated: SwiftGen header skipped, "Generated" comment past the header kept.
out=$(scripts/pr-check signals --diff $F/swift/diff-generated.patch)
has "$out" "generated (skipped): Modules/Assets/Strings.swift" "generated signals"
has "$out" "new types: 1" "generated signals"
has "$out" "ThumbnailCache (class)" "generated signals"
echo "$out" | grep -q "states" && err "generated signals: SwiftGen enum counted"
scripts/pr-check check $F/swift/body-generated.md --diff $F/swift/diff-generated.patch >/dev/null \
  || err "generated: body with a plain translations line red"
tmp=$(mktemp); sed '/Generated using SwiftGen/d' $F/swift/diff-generated.patch > "$tmp"
out=$(scripts/pr-check signals --diff "$tmp"); rm -f "$tmp"
has "$out" "states: Sync (3)" "generated without header"
[ "$fail" = 0 ] && echo "✅ generated files skipped"

# Base: temp repo with a local bare origin, no network. Each commit adds one type.
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
pc="$PWD/scripts/pr-check"
g() { git -c user.name=t -c user.email=t@t -c init.defaultBranch=develop "$@" >/dev/null 2>&1; }
add() { printf 'struct %s {\n    let id: Int\n}\n' "$2" > "$1/$2.swift"; g -C "$1" add -A; g -C "$1" commit -m "$2"; }
base_case() { # name, expected note, type of the branch, type of the base (must not show)
  out=$(cd "$t/work" && "$pc" signals develop 2>&1)
  has "$out" "$2" "base $1"; has "$out" "$3 (struct)" "base $1"
  echo "$out" | grep -q "$4 (struct)" && err "base $1: $4 from the base counted"
}
g init --bare "$t/origin.git"
g clone "$t/origin.git" "$t/work"; add "$t/work" Root; g -C "$t/work" push -u origin develop
g clone "$t/origin.git" "$t/peer"

add "$t/peer" Remote1; g -C "$t/peer" push                          # local develop behind 1
g -C "$t/work" fetch; g -C "$t/work" checkout -b behind origin/develop; add "$t/work" Behind
base_case behind "base: origin/develop (local behind 1)" Behind Remote1

g -C "$t/work" checkout develop; g -C "$t/work" merge --ff-only origin/develop
add "$t/work" LocalOnly                                              # local develop ahead 1
g -C "$t/work" checkout -b ahead; add "$t/work" Ahead
base_case ahead "base: develop (local ahead 1)" Ahead LocalOnly

g -C "$t/peer" pull; add "$t/peer" Remote2; g -C "$t/peer" push    # ahead 1, behind 1
g -C "$t/work" fetch; g -C "$t/work" checkout -b diverged origin/develop; add "$t/work" Diverged
base_case diverged "local diverged (ahead 1, behind 1)" Diverged Remote2

echo 'Gen.swift linguist-generated' > "$t/work/.gitattributes"; add "$t/work" Gen
out=$(cd "$t/work" && "$pc" signals develop 2>&1)
has "$out" "generated (skipped): Gen.swift" "linguist-generated"
out=$(cd "$t/work" && "$pc" signals "$(git -C "$t/work" rev-parse origin/develop)" 2>&1)
has "$out" "(as given, not refreshed)" "base sha"
has "$out" "Diverged (struct)" "base sha"
[ "$fail" = 0 ] && echo "✅ base resolved"

# Steps: one Changes line per code commit, in order, folded when the commit has signals.
g -C "$t/work" checkout -b steps develop
mkdir -p "$t/work/Old"; printf 'struct Row {\n    let id: Int\n}\n' > "$t/work/Old/Row.swift"
g -C "$t/work" add -A; g -C "$t/work" commit -m "chore: base row"; g -C "$t/work" push origin steps:develop --force
g -C "$t/work" fetch
mkdir -p "$t/work/New"; g -C "$t/work" mv Old/Row.swift New/Row.swift
g -C "$t/work" commit -m "refactor: Déplacement de Row"
printf 'struct Line {\n    let id: Int\n}\n' > "$t/work/New/Row.swift"; g -C "$t/work" mv New/Row.swift New/Line.swift
g -C "$t/work" commit -am "refactor: Renommage de Row en Line"
printf 'struct Row {\n    let id: Int\n}\n' > "$t/work/New/Line.swift"; g -C "$t/work" mv New/Line.swift New/Row.swift
g -C "$t/work" commit -am "refactor: Renommage de Line en Row"
printf 'struct Row {\n    let id: Int\n    let meters: Int\n}\n' > "$t/work/New/Row.swift"
g -C "$t/work" commit -am "feat: Ajout des mètres dans Row"
mkdir -p "$t/work/.whackagent"; echo x > "$t/work/.whackagent/task.md"
g -C "$t/work" add -A; g -C "$t/work" commit -m "docs: Mise à jour de la tâche"
out=$(cd "$t/work" && "$pc" signals develop --steps 2>&1)
has "$out" "steps: 3 code commits" "steps signals"
has "$out" "Row.meters stored" "steps signals"
fold='<dl><dd><details>\n<summary>Ajout des mètres dans Row : en mètres</summary>\n<dl><dd><br>\n\n**Avant** : rien.\n\n</dd></dl>\n</details></dd></dl>'
printf "Intro.\n\n## Changements\n- Déplacement de Row : seul\n- Renommage de Row en Line\n- Renommage de Line en Row\n\n$fold\n\n## À tester\n- [ ] ok\n" > "$t/good.md"
(cd "$t/work" && "$pc" check "$t/good.md" develop --steps >/dev/null) || err "steps: good body red"
printf "Intro.\n\n## Changements\n- Ajout des mètres dans Row\n\n## À tester\n- [ ] ok\n" > "$t/flat.md"
out=$(cd "$t/work" && "$pc" check "$t/flat.md" develop --steps 2>&1) && err "steps: line without fold green"
has "$out" "has signals, its Changes line does not fold" "steps flat body"
printf "Intro.\n\n## Changements\n- Autre chose\n\n## À tester\n- [ ] ok\n" > "$t/none.md"
out=$(cd "$t/work" && "$pc" check "$t/none.md" develop --steps 2>&1) && err "steps: missing line green"
has "$out" "no Changes line starting with it" "steps missing line"
[ "$fail" = 0 ] && echo "✅ steps checked"

[ "$fail" = 0 ] && echo "✅ pr-check proven"
exit "$fail"
